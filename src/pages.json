{
  "easycom": {
    "autoscan": true,
    // 注意一定要放在custom里，否则无效，https://ask.dcloud.net.cn/question/131175
    "custom": {
      "^u--(.*)": "uview-plus/components/u-$1/u-$1.vue",
      "^up-(.*)": "uview-plus/components/u-$1/u-$1.vue",
      "^u-([^-].*)": "uview-plus/components/u-$1/u-$1.vue"
    }
  },
  "pages": [
    //pages数组中第一项表示应用启动页，参考：https://uniapp.dcloud.io/collocation/pages
    {
      "path": "pages/tabBar/home/index",
      "style": {
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/tabBar/category/index",
      "style": {
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/tabBar/my/index",
      "style": {
        "navigationStyle": "custom"
      }
    }
  ],
  "subPackages": [
    {
      "root": "pages/calculator",
      "pages": [
        {
          "path": "index",
          "style": {
            "navigationBarTitleText": "计算器",
            "navigationStyle": "custom"
          }
        }
      ]
    },
    {
      "root": "pages/sign",
      "pages": [
        {
          "path": "index",
          "style": {
            "navigationBarTitleText": "签到"
          }
        }
      ]
    },
    {
      "root": "pages/login",
      "pages": [
        {
          "path": "index",
          "style": {
            "navigationStyle": "custom"
          }
        }
      ]
    },
    {
      "root": "pages/detail",
      "pages": [
        {
          "path": "index",
          "style": {
            "navigationStyle": "custom"
          }
        }
      ]
    },
    {
      "root": "pages/publish",
      "pages": [
        {
          "path": "index",
          "style": {
            "navigationStyle": "custom"
          }
        }
      ]
    }
  ],
  "preloadRule": {
    "pages/tabBar/home/index": {
      "network": "all",
      "packages": ["pages/calculator"]
    }
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarBackgroundColor": "#F8F8F8",
    "backgroundColor": "#F8F8F8"
  },
  "tabBar": {
    "color": "#7A7E83",
    "selectedColor": "#3cc51f",
    "borderStyle": "black",
    "backgroundColor": "#F8F8F8",
    "list": [
      {
        "pagePath": "pages/tabBar/home/index",
        "text": "首页",
        "iconPath": "static/images/tabBar/home.png",
        "selectedIconPath": "static/images/tabBar/home-active.png"
      },
      {
        "pagePath": "pages/tabBar/category/index",
        "text": "分类",
        "iconPath": "static/images/tabBar/category.png",
        "selectedIconPath": "static/images/tabBar/category-active.png"
      },
      {
        "pagePath": "pages/tabBar/my/index",
        "text": "我的",
        "iconPath": "static/images/tabBar/my.png",
        "selectedIconPath": "static/images/tabBar/my-active.png"
      }
    ]
  }
}